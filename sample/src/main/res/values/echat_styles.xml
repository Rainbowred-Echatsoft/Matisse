<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="EChatTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="EChatTheme.AppBarOverlay.BLACK" parent="EChatTheme.AppBarOverlay">
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="actionMenuTextColor">@android:color/black</item>
    </style>

    <!-- 图片选择器主题-->
    <style name="Matisse.EChat" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/echatColorPrimary</item>
        <item name="colorPrimaryDark">@color/echatColorPrimaryDark</item>
        <item name="toolbar">@style/EChatTheme.AppBarOverlay.BLACK</item>
        <item name="album.dropdown.title.color">@color/echat_album_dropdown_title_text</item>
        <item name="album.dropdown.count.color">@color/echat_album_dropdown_count_text</item>
        <item name="album.element.color">@android:color/black</item>
        <item name="album.thumbnail.placeholder">@color/zhihu_album_dropdown_thumbnail_placeholder
        </item>
        <item name="album.emptyView">@drawable/ic_empty_zhihu</item>
        <item name="album.emptyView.textColor">@color/dracula_album_empty_view</item>
        <item name="partialMedia.bg">@color/zhihu_page_bg</item>
        <item name="partialMedia.textColor">@color/zhihu_partial_media_text</item>
        <item name="partialMedia.button.textColor">@color/echat_partial_media_button_text</item>
        <item name="partialMedia.button.color">@color/echat_partial_media_button_bg</item>
        <item name="item.placeholder">@color/zhihu_item_placeholder</item>
        <item name="item.checkCircle.backgroundColor">
            @color/zhihu_item_checkCircle_backgroundColor
        </item>
        <item name="item.checkCircle.borderColor">@color/zhihu_item_checkCircle_borderColor</item>
        <item name="page.bg">@color/zhihu_page_bg</item>
        <item name="bottomToolbar.bg">@color/zhihu_bottom_toolbar_bg</item>
        <item name="bottomToolbar.preview.textColor">@color/echat_bottom_toolbar_preview</item>
        <item name="bottomToolbar.apply.textColor">@color/echat_bottom_toolbar_apply</item>
        <item name="preview.bottomToolbar.back.textColor">
            @color/zhihu_preview_bottom_toolbar_back_text
        </item>
        <item name="preview.bottomToolbar.apply.textColor">
            @color/zhihu_preview_bottom_toolbar_apply
        </item>
        <item name="android:listPopupWindowStyle">@style/Popup.Custom</item>
        <item name="listPopupWindowStyle">@style/Popup.Custom</item>
        <item name="capture.textColor">@color/echat_capture_textColor</item>
    </style>

    <style name="Popup.Custom" parent="Widget.AppCompat.ListPopupWindow">
        <item name="android:popupBackground">@color/zhihu_album_popup_bg</item>
    </style>

</resources>